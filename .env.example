# 배포·로컬 실행 환경변수 (docs/DEPLOY.md 참조)
# 실제 .env는 커밋되지 않습니다(.gitignore). 이 파일은 형식만 보여줍니다.

# ── 모드 (조용한 대체 없음 — 값이 없으면 기동/요청 시 즉시 실패) ──
# LLM은 Claude 하나(2026-10 통일) — 예전 LLM_PROVIDER=openai|friendli|local 값이 남아 있으면 지우세요
SAAS_AUTH=supabase             # supabase | firebase | dev
SAAS_STORE=supabase            # supabase | firestore | local

# ── Supabase ──
# URL/ANON_KEY: 대시보드 Settings → API. ANON은 공개 키(브라우저에 나가도 정상).
# SERVICE_KEY: 같은 화면의 service_role. **절대 브라우저·커밋에 노출 금지** —
# RLS를 우회하는 키라 유출되면 전 워크스페이스 데이터가 열린다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_KEY=eyJhbGci...

# ── 접근 제어 (fail-closed) ──
# 비어 있으면 전원 거부다. 열려면 명시적으로 열어야 한다.
SAAS_ALLOWED_USERS=you@company.com,teammate@company.com

# ── LLM — Claude (기본) ──
# 키는 이 파일(.env)에만. 채팅·코드·커밋에 붙여넣지 말 것. 웹의 모델 토글에서 직접 입력해도
# 엔진 .env에 저장된다(응답·로그에는 마스킹만).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5     # 기본값. 사고는 항상 켜져 있고 effort로 조절한다
# ANTHROPIC_MODEL_FAST=             # 판정이 아닌 좁은 추출용(비면 기본 모델)
# ANTHROPIC_EFFORT=medium           # 일반 호출
# ANTHROPIC_EFFORT_DEEP=high        # 다층 독해·판정(deep 경로)
# ANTHROPIC_VISION_MODEL=           # IR덱 근거 위치(bbox) 비전 — 비면 ANTHROPIC_MODEL

# ── 메시징 플랫폼 (docs/MESSAGING_PLATFORM.md) ──
# CHAT_CONTROL_DSN=postgresql://...   # 컨트롤 플레인 DB
# <셀 DSN 환경변수>=postgresql://...   # cells.dsn_env가 가리키는 이름(예: CELL_A_DSN)
# CHAT_FANOUT=supabase                # supabase | redis | memory | none
# CHAT_REDIS_URL=redis://...          # 속도 제한(필수 권장)·redis 팬아웃
# SUPABASE_JWT_SECRET=...             # Realtime 토픽 토큰 서명(Realtime 프로젝트의 JWT 비밀)
# CHAT_RT_MAX_EPS=80                  # 초당 알림 상한 ≈ 플랜 이벤트 한도 ÷ 채널당 평균 구독자
# CHAT_CRON_SECRET=...                # /platform/v1/jobs/tick 크론 비밀
# CHAT_MOVE_INLINE=1                  # 셀 이동을 API 프로세스가 직접 집는다(작업자 없는 단일 서버).
#                                     # `python -m app.chat.worker`를 따로 띄우면 0
# NEXT_PUBLIC_CHAT_REALTIME=supabase  # (웹) 브라우저가 Supabase Realtime으로 구독

# ── 외부 API ──
TAVILY_API_KEY=tvly-...

# ── 비용 하드캡 (USD) ──
COST_CAP_REQUEST_USD=5
COST_CAP_MONTH_USD=100
COST_CAP_GLOBAL_MONTH_USD=50       # 전 워크스페이스 합 — 계정을 지키는 마지막 방어선

# ── 배포 스크립트용 (scripts/deploy.sh) ──
GCP_PROJECT=your-gcp-project
GCP_REGION=asia-northeast3
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# ── 로컬 개발 폴백 ──
# SAAS_AUTH=dev 로 두면 X-Dev-User 헤더를 uid로 신뢰한다(로컬 전용).
# SAAS_STORE=local 이면 sqlite 단일 파일을 쓴다.
# SAAS_DB_PATH=saas.db

# 실전 스니펫 캡처 (B5 골든셋 증강) — 경로를 지정할 때만 기록한다.
# Cloud Run에서는 파일시스템이 인스턴스 메모리라 켜지 않는 것이 맞다.
SNIPPET_LOG_PATH=dataset/snippet_log.jsonl
