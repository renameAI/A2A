{
  "manifest_version": 3,
  "name": "A2A Browser",
  "short_name": "A2A",
  "version": "0.1.0",
  "description": "AI 채팅·팀 채널·브라우저 에이전트 — A2A Browser의 내장 기능",
  "minimum_chrome_version": "140",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "A2A — AI 채팅·팀 채널",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "contextMenus",
    "notifications",
    "alarms",
    "unlimitedStorage",
    "downloads",
    "downloads.open",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "A2A 패널 열기"
    }
  }
}
