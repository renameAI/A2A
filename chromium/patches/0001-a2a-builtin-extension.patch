+void ComponentLoader::AddA2AExtension() {
+#if !BUILDFLAG(IS_ANDROID)
+  base::FilePath resources;
+  if (!base::PathService::Get(chrome::DIR_RESOURCES, &resources)) {
+    return;
+  }
+  const base::FilePath dir = resources.AppendASCII("a2a");
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(dir, &error);
+  if (!manifest) {
+    LOG(ERROR) << "A2A extension not loaded from " << dir << ": " << error;
+    return;
+  }
+  Add(std::move(*manifest), dir, /*skip_allowlist=*/false);
+#endif  // !BUILDFLAG(IS_ANDROID)
+}
